{
  "info": {
    "name": "TaskFlow API",
    "description": "Repeatable smoke and negative-path API tests for TaskFlow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "testEmail",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": "TaskFlow-Test-Password-123!"
    },
    {
      "key": "csrfToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Reports healthy status', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Database readiness",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Database is connected', function () { pm.expect(pm.response.json().database).to.eql('connected'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Registration rejects an empty body",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Returns a validation error', function () { const body = pm.response.json(); pm.expect(body.error.code).to.eql('VALIDATION_ERROR'); pm.expect(body.error.details).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Login rejects an empty body",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Returns a validation error', function () { pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh rejects a missing refresh token",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/refresh"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 401', function () { pm.response.to.have.status(401); });",
              "pm.test('Returns an invalid refresh token error', function () { pm.expect(pm.response.json().error.code).to.eql('INVALID_REFRESH_TOKEN'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Current user requires authentication",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 401', function () { pm.response.to.have.status(401); });",
              "pm.test('Returns an authentication error', function () { pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown route returns 404",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/this-route-should-not-exist"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 404', function () { pm.response.to.have.status(404); });",
              "pm.test('Returns a controlled not found error', function () { pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Authenticated workflow",
      "item": [
        {
          "name": "1. Register test user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = `taskflow-${pm.variables.replaceIn('{{$guid}}')}@example.com`;",
                  "pm.collectionVariables.set('testEmail', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration succeeds', function () { pm.response.to.have.status(201); });",
                  "pm.test('Registration returns the generated email', function () { const response = pm.response.json(); pm.expect(response.data.email).to.eql(pm.collectionVariables.get('testEmail')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"displayName\": \"TaskFlow API Test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "2. Login test user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
                  "pm.test('Login returns the expected user', function () { const response = pm.response.json(); pm.expect(response.data).to.exist; pm.expect(response.data.email).to.eql(pm.collectionVariables.get('testEmail')); });",
                  "pm.test('Access and refresh cookies are set', function () { const headers = pm.response.headers.all().filter(header => header.key.toLowerCase() === 'set-cookie').map(header => header.value).join('\\n'); pm.expect(headers).to.include('access_token='); pm.expect(headers).to.include('refresh_token='); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "3. Get current user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 200 for an authenticated user', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns the logged-in user', function () {",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.data).to.exist;",
                  "  pm.expect(response.data.email).to.eql(pm.collectionVariables.get('testEmail'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "4. Get CSRF token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns a CSRF token', function () {",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.data).to.exist;",
                  "  pm.expect(response.data.csrfToken).to.be.a('string');",
                  "  pm.expect(response.data.csrfToken.length).to.be.greaterThan(0);",
                  "  pm.collectionVariables.set('csrfToken', response.data.csrfToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/csrf-token"
          }
        },
        {
          "name": "5. Logout rejects missing CSRF token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 403', function () {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test('Returns a CSRF error', function () {",
                  "  pm.expect(pm.response.json().error.code).to.eql('INVALID_CSRF_TOKEN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        },
        {
          "name": "6. Logout succeeds with CSRF token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        },
        {
          "name": "7. Current user rejects logged-out session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 401 after logout', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Returns an authentication error', function () {",
                  "  pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        }
      ]
    }
  ]
}
